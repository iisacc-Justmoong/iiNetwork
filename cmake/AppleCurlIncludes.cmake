function(iinetwork_normalize_apple_curl target sysroot)
    get_target_property(actual "${target}" ALIASED_TARGET)
    if(NOT actual)
        set(actual "${target}")
    endif()
    get_target_property(includes "${actual}" INTERFACE_INCLUDE_DIRECTORIES)
    if(includes)
        list(REMOVE_ITEM includes "${sysroot}/usr/include")
        set_property(TARGET "${actual}" PROPERTY INTERFACE_INCLUDE_DIRECTORIES "${includes}")
    endif()
endfunction()
