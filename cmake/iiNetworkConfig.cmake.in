@PACKAGE_INIT@
if(EMSCRIPTEN)
    # Emscripten supports side modules although its CMake toolchain defaults
    # the shared-library capability to false.
    set_property(GLOBAL PROPERTY TARGET_SUPPORTS_SHARED_LIBS TRUE)
endif()
include(CMakeFindDependencyMacro)
set(iiNetwork_HTTP_SERVER_LIFECYCLE TRUE)
set(iiNetwork_REALTIME_LATEST TRUE)
find_dependency(iiSDKCore 0.19 CONFIG COMPONENTS Runtime)
# The Core/Network composition is supplied by iiNetworkLoadBalancer separately.
set(iiNetwork_LOAD_BALANCER FALSE)
find_dependency(iiJson 0.1 CONFIG)
find_dependency(CURL 7.62)
find_dependency(OpenSSL 3 COMPONENTS Crypto SSL)
if(APPLE)
    include("${CMAKE_CURRENT_LIST_DIR}/AppleCurlIncludes.cmake")
    iinetwork_normalize_apple_curl(CURL::libcurl "${CMAKE_OSX_SYSROOT}")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/iiNetworkTargets.cmake")
check_required_components(iiNetwork)
