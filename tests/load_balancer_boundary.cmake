file(READ "${ROOT}/CMakeLists.txt" build_script)
file(READ "${ROOT}/src/Core/Network.h" umbrella)
file(READ "${ROOT}/cmake/iiNetworkConfig.cmake.in" config)
if(build_script MATCHES "src/[^ \t\r\n)]*LoadBalancer[.]" OR umbrella MATCHES "iiNetwork/LoadBalancer[.]h")
    message(FATAL_ERROR "The base iiNetwork package still owns the cross-SDK load balancer")
endif()
if(config MATCHES "set\(iiNetwork_LOAD_BALANCER TRUE\)")
    message(FATAL_ERROR "The base package advertises the detached load balancer")
endif()
file(GLOB_RECURSE _base_adapters "${ROOT}/src/*LoadBalancer.h" "${ROOT}/src/*LoadBalancer.cpp")
if(_base_adapters)
    message(FATAL_ERROR "The adapter remains in the SDK source tree")
endif()
if(NOT EXISTS "${ROOT}/example/LoadBalancer/App/iiNetwork/LoadBalancer.h")
    message(FATAL_ERROR "The independently configured load-balancer adapter is missing")
endif()
