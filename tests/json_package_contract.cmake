if(NOT SOURCE_ROOT)
    message(FATAL_ERROR "SOURCE_ROOT is required")
endif()
file(READ "${SOURCE_ROOT}/CMakeLists.txt" build)
file(READ "${SOURCE_ROOT}/cmake/iiNetworkConfig.cmake.in" package)
if(NOT build MATCHES "project\\(iiNetwork VERSION 0\\.6\\.1")
    message(FATAL_ERROR "The iiJson value boundary requires iiNetwork 0.6.1")
endif()
if(NOT build MATCHES "find_package\\(iiJson 0\\.1\\.2 CONFIG REQUIRED")
    message(FATAL_ERROR "Building iiNetwork must require iiJson 0.1.2")
endif()
if(NOT package MATCHES "find_dependency\\(iiJson 0\\.1\\.2 CONFIG")
    message(FATAL_ERROR "Installed consumers must require iiJson 0.1.2")
endif()
