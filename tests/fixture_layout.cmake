if(NOT RESOURCE_ROOT OR NOT FIXTURE)
    message(FATAL_ERROR "RESOURCE_ROOT and FIXTURE are required")
endif()
if(IS_SYMLINK "${RESOURCE_ROOT}")
    message(FATAL_ERROR "Resource state root must not be a symlink")
endif()
cmake_path(ABSOLUTE_PATH RESOURCE_ROOT NORMALIZE OUTPUT_VARIABLE root)
cmake_path(ABSOLUTE_PATH FIXTURE NORMALIZE OUTPUT_VARIABLE fixture)
cmake_path(IS_PREFIX root "${fixture}" NORMALIZE inside)
if(NOT inside OR fixture STREQUAL root)
    message(FATAL_ERROR "TLS fixture must be a child of the resource state directory")
endif()
