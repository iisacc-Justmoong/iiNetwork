if(NOT EXISTS "${IMAGE}" OR NOT EXISTS "${EXPECTED}")
    message(FATAL_ERROR "Shared library or linked test executable is missing")
endif()
if(EXPECTED MATCHES "\\.(a|lib)$")
    message(FATAL_ERROR "SDK target is still an archive, not a shared library: ${EXPECTED}")
endif()
file(GET_RUNTIME_DEPENDENCIES EXECUTABLES "${IMAGE}" RESOLVED_DEPENDENCIES_VAR _resolved
    UNRESOLVED_DEPENDENCIES_VAR _unresolved)
file(REAL_PATH "${EXPECTED}" _wanted)
set(_found FALSE)
foreach(_path IN LISTS _resolved)
    file(REAL_PATH "${_path}" _actual)
    if(_actual STREQUAL _wanted)
        set(_found TRUE)
    endif()
endforeach()
if(NOT _found)
    message(FATAL_ERROR "Executable does not dynamically link the SDK library: ${EXPECTED}; ${_unresolved}")
endif()
