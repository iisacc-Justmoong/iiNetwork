if(NOT SOURCE_ROOT)
    message(FATAL_ERROR "SOURCE_ROOT is required")
endif()

file(READ "${SOURCE_ROOT}/LICENSE" license_text)
if(NOT license_text MATCHES "Apache License")
    message(FATAL_ERROR "LICENSE is not the Apache License")
endif()
if(NOT license_text MATCHES "Version 2\\.0, January 2004")
    message(FATAL_ERROR "LICENSE is not Apache License Version 2.0")
endif()
if(NOT license_text MATCHES "http://www\\.apache\\.org/licenses/")
    message(FATAL_ERROR "LICENSE is missing the Apache license URL")
endif()
if(NOT license_text MATCHES "END OF TERMS AND CONDITIONS")
    message(FATAL_ERROR "LICENSE is missing the Apache terms ending")
endif()
if(NOT license_text MATCHES "APPENDIX: How to apply the Apache License")
    message(FATAL_ERROR "LICENSE is missing the Apache appendix")
endif()
if(license_text MATCHES "GNU AFFERO GENERAL PUBLIC LICENSE" OR license_text MATCHES "GNU Affero General Public License")
    message(FATAL_ERROR "LICENSE still contains the Affero GPL")
endif()
if(license_text MATCHES "MIT License")
    message(FATAL_ERROR "LICENSE still contains the MIT License")
endif()

file(READ "${SOURCE_ROOT}/NOTICE" notice_text)
if(NOT notice_text MATCHES "Copyright \\(c\\) 2026 iisacc")
    message(FATAL_ERROR "NOTICE is missing Copyright (c) 2026 iisacc")
endif()
if(NOT notice_text MATCHES "Apache")
    message(FATAL_ERROR "NOTICE does not name the Apache License")
endif()

foreach(document README.md AGENT.md docs/License.md)
    file(READ "${SOURCE_ROOT}/${document}" document_text)
    if(NOT document_text MATCHES "Apache License 2\\.0" AND NOT document_text MATCHES "Apache-2\\.0")
        message(FATAL_ERROR "${document} does not state Apache-2.0")
    endif()
endforeach()
file(READ "${SOURCE_ROOT}/README.md" readme_text)
if(NOT readme_text MATCHES "SPDX-License-Identifier: Apache-2\\.0")
    message(FATAL_ERROR "README.md is missing SPDX-License-Identifier: Apache-2.0")
endif()
file(READ "${SOURCE_ROOT}/docs/License.md" korean_text)
if(NOT korean_text MATCHES "SPDX-License-Identifier: Apache-2\\.0")
    message(FATAL_ERROR "docs/License.md is missing SPDX-License-Identifier: Apache-2.0")
endif()

foreach(package_config cmake/iiNetworkConfig.cmake.in example/LoadBalancer/cmake/iiNetworkLoadBalancerConfig.cmake.in)
    file(READ "${SOURCE_ROOT}/${package_config}" config_text)
    if(NOT config_text MATCHES "_SPDX_LICENSE \"Apache-2\\.0\"")
        message(FATAL_ERROR "${package_config} does not export SPDX Apache-2.0")
    endif()
endforeach()

file(READ "${SOURCE_ROOT}/CMakeLists.txt" project_text)
if(NOT project_text MATCHES "set\\(iiNetwork_SPDX_LICENSE \"Apache-2\\.0\"\\)")
    message(FATAL_ERROR "CMakeLists.txt does not set iiNetwork_SPDX_LICENSE")
endif()
if(NOT project_text MATCHES "install\\(FILES README\\.md LICENSE NOTICE")
    message(FATAL_ERROR "CMakeLists.txt does not install LICENSE and NOTICE")
endif()

file(READ "${SOURCE_ROOT}/example/LoadBalancer/CMakeLists.txt" balancer_text)
if(NOT balancer_text MATCHES "set\\(iiNetworkLoadBalancer_SPDX_LICENSE \"Apache-2\\.0\"\\)")
    message(FATAL_ERROR "Load balancer CMake does not set its SPDX license")
endif()
